{
  "name": "react-doctor-local",
  "version": "0.1.4",
  "description": "Local-only React codebase diagnostics with no telemetry or remote scoring",
  "homepage": "https://github.com/leprincep35700/react-doctor-local#readme",
  "bugs": {
    "url": "https://github.com/leprincep35700/react-doctor-local/issues"
  },
  "license": "MIT",
  "author": "Aiden Bai and contributors; local-only fork by Veonum.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/leprincep35700/react-doctor-local.git"
  },
  "bin": {
    "react-doctor": "./packages/react-doctor/bin/react-doctor.js",
    "react-doctor-local": "./packages/react-doctor/bin/react-doctor.js"
  },
  "files": [
    "packages/react-doctor/bin/**",
    "packages/react-doctor/dist/**",
    "packages/react-doctor/README.md",
    "packages/react-doctor/package.json",
    "packages/react-doctor/assets/**",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=react-doctor-local",
    "build": "turbo run build --filter=react-doctor-local",
    "test": "turbo run test --filter=react-doctor-local",
    "typecheck": "turbo run typecheck",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "agent-install": "0.0.5",
    "commander": "^14.0.3",
    "knip": "^6.10.0",
    "ora": "^9.4.0",
    "oxlint": "^1.63.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "typescript": ">=5.0.4 <7"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.6.0",
    "@voidzero-dev/vite-plus-core": "^0.1.15",
    "turbo": "^2.9.7",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.15"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@10.29.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "oxlint": "^1.63.0",
      "oxlint-tsgolint": "^0.22.1"
    }
  }
}
